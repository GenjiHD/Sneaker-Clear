{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SneakerClean",
  "version": "0.1.1",
  "identifier": "com.joaquin.sneakerclear",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sneaker Cleaning Admin",
        "width": 1200,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "devtools": true 
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://sneaker-clear.onrender.com http://localhost:8080 tauri://localhost http://tauri.localhost; frame-src 'self' https://sneaker-clear.onrender.com; object-src 'self' https://sneaker-clear.onrender.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}